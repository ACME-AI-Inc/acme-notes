{
  "name": "acme-notes",
  "version": "1.0.0",
  "description": "Acme Notes demo with browser-local notes, a Vercel deletion API and PostHog telemetry.",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "node build.mjs",
    "demo:check": "node demo/check-editor.mjs",
    "demo:check-webhook": "node --test demo/webhook.test.mjs",
    "demo:check-export": "node demo/check-export.mjs",
    "start": "npm run build && node demo/serve.mjs --port 8080",
    "demo:check-delete": "node demo/check-delete.mjs",
    "demo:serve": "node demo/serve.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACME-AI-Inc/acme-notes.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ACME-AI-Inc/acme-notes/issues"
  },
  "homepage": "https://github.com/ACME-AI-Inc/acme-notes#readme",
  "dependencies": {
    "@vercel/functions": "^3.11.2",
    "posthog-js": "^1.447.15",
    "posthog-node": "5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
