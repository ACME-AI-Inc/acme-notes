# Public project ingestion token, not a personal API key.
POSTHOG_KEY=your_project_token
POSTHOG_HOST=your_project_ingestion_host
POSTHOG_UI_HOST=your_project_ui_host
# Absolute ingest host for server functions; the browser can keep its /n-sync proxy.
POSTHOG_SERVER_HOST=your_project_ingestion_host
