{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/n-sync/static/:path*", "destination": "https://eu-assets.i.posthog.com/static/:path*" },
    { "source": "/n-sync/array/:path*", "destination": "https://eu-assets.i.posthog.com/array/:path*" },
    { "source": "/n-sync/:path*/", "destination": "https://eu.i.posthog.com/:path*/" },
    { "source": "/n-sync/:path*", "destination": "https://eu.i.posthog.com/:path*" },
    { "source": "/((?!api/|n-sync/).*)", "destination": "/index.html" }
  ]
}
